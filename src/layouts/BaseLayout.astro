---
import "@/styles/global.css";
import BottomNav from "@/components/content/BottomNav.astro";
import SiteHeader from "@/components/content/SiteHeader.astro";
import StateControls from "@/components/content/StateControls.astro";
import UpdateNotice from "@/components/content/UpdateNotice.astro";
import BaseHead from "@/components/utility/BaseHead.astro";

type Props = {
  /** Page title. The site name is appended. */
  title?: string;
  /** Page description. */
  description?: string;
  /** Navigation, saved-progress controls and the client script. */
  chrome?: boolean;
};

const { title, description, chrome = true } = Astro.props;
---

<!doctype html>
<html lang="en" data-section="shop">
  <head>
    <BaseHead title={title} description={description} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to the checklists
    </a>
    <SiteHeader />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    {chrome && <StateControls />}
    {chrome && <BottomNav />}
    {chrome && <UpdateNotice />}
  </body>
</html>

{chrome && <script>
  import "@/scripts/app.ts";
</script>}

<style is:global>
  @layer components {
    body {
      padding-block-end: calc(
        var(--bottom-nav-height) + env(safe-area-inset-bottom, 0px)
      );
    }

    .skip-link {
      position: absolute;
      inset-block-start: -100%;
      inset-inline-start: var(--site-margin);
      z-index: 20;
      padding: 0.5rem 0.875rem;
      border-radius: 0.5rem;
      background: var(--text);
      color: var(--background);
      font-size: 0.875rem;

      &:focus {
        inset-block-start: var(--space-2);
      }
    }
  }
</style>
